<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Annotate Picture" Manufacturer="Laurent Bernabé" Version="$(var.AppVersion)"
           UpgradeCode="6f0c3f0e-5a41-4c7e-9d6b-2b1f6f0a7c11" Scope="perMachine">
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnnotatePicture">
        <Files Include="..\build\windows\x64\runner\Release\**" />
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
